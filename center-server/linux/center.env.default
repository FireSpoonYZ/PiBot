# /etc/pibot-center/center.env — PiBot 中心服务配置（权限 0640，升级保留修改）
# 中心默认只监听本机回环 HTTP 127.0.0.1:8080，外部 HTTPS/WSS 由 Nginx/Caddy 反代提供。

# 可选：预设对外 HTTPS 根地址（也可在首次网页初始化时直接填写）；修改后重启 pibot-center：
# CENTER_PUBLIC_URL=https://center.example.com

# 本机监听地址与端口（反代在本机时保持 127.0.0.1 即可）：
CENTER_LISTEN_HOST=127.0.0.1
CENTER_PORT=8080

# 可选：逗号分隔的可信反向代理 IP/CIDR；默认 false。
CENTER_TRUST_PROXY=false
