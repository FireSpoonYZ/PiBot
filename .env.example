# Example only — copy to a protected location, never commit real values.
# Android release signing: -P properties or the matching ANDROID_RELEASE_*
# environment variables (resolved lazily, only when release tasks run).
# android.releaseKeystore=/secure/path/release.keystore
# android.releaseStorePassword=...
# android.releaseKeyAlias=...
# android.releaseKeyPassword=...
# env equivalents: ANDROID_RELEASE_KEYSTORE / ANDROID_RELEASE_STORE_PASSWORD /
#                  ANDROID_RELEASE_KEY_ALIAS / ANDROID_RELEASE_KEY_PASSWORD
# android.versionCode=3   # bump per distributed APK; never reuse

# Tauri updater signing (CI only): private key for TAURI_SIGNING_PRIVATE_KEY.
# Generate with: tauri signer generate
# The matching public key is compiled in via E_LAUNCHER_UPDATER_PUBLIC_KEY.
# TAURI_SIGNING_PRIVATE_KEY=<contents of updater key file>

# Center (self-hosted) — see docs/center-linux-deployment.md for the real flow.
# CENTER_PUBLIC_URL=https://center.example.com
# CENTER_ENCRYPTION_KEY_HEX=<64 hex chars>
# CENTER_SESSION_KEY_HEX=<64 hex chars>
# CENTER_OWNER_PASSWORD_HASH='scrypt$<salt hex>$<key hex>'
