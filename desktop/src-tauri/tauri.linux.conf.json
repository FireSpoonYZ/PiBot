{
  "productName": "pibot",
  "bundle": {
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "tigervnc-standalone-server",
          "xfwm4 | openbox",
          "xfdesktop4",
          "xfce4-panel",
          "xfconf",
          "xfce4-terminal",
          "xauth",
          "dbus",
          "xdotool",
          "ffmpeg",
          "sudo",
          "libatomic1"
        ],
        "provides": [
          "e-launcher-desktop"
        ],
        "conflicts": [
          "e-launcher-desktop"
        ],
        "replaces": [
          "e-launcher-desktop"
        ],
        "preInstallScript": "../linux/e-launcher-host.preinst",
        "postInstallScript": "../linux/e-launcher-host.postinst",
        "preRemoveScript": "../linux/e-launcher-host.prerm",
        "postRemoveScript": "../linux/e-launcher-host.postrm",
        "files": {
          "/usr/lib/systemd/user/e-launcher-host.service": "../linux/e-launcher-host.service",
          "/usr/lib/pibot/pibot-hostctl": "../linux/pibot-hostctl",
          "/etc/sudoers.d/pibot-hostctl": "../linux/pibot.sudoers"
        }
      },
      "rpm": {
        "depends": [
          "tigervnc-server",
          "libatomic",
          "(xfwm4 or openbox)",
          "xfdesktop",
          "xfce4-panel",
          "xfconf",
          "xfce4-terminal",
          "xorg-x11-xauth",
          "dbus",
          "xdotool",
          "(ffmpeg-free or ffmpeg)"
        ],
        "obsoletes": [
          "e-launcher-desktop"
        ],
        "files": {
          "/usr/lib/systemd/user/e-launcher-host.service": "../linux/e-launcher-host.service"
        }
      }
    }
  }
}
