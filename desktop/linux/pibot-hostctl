#!/bin/sh
# pibot-hostctl — limited root helper for pibot DEB lifecycle.
#
# Installed at /usr/lib/pibot/pibot-hostctl (root-owned,
# not user-writable) and invoked by `pibot-host enable|remove` through
# `sudo -n`. It records the calling user's Host/XDG paths and enables linger
# for that same UID. It never executes user-supplied commands or stores secrets.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

REGDIR="/var/lib/e-launcher/hosts"

die() { echo "pibot-hostctl: $*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || die "must run as root"
[ -n "${SUDO_UID:-}" ] || die "SUDO_UID is not set"
case "$SUDO_UID" in
  ''|*[!0-9]*) die "invalid SUDO_UID '$SUDO_UID'" ;;
esac
# Only real unprivileged users may register; root (uid 0) and system-ish
# accounts must not end up in the lifecycle registry.
[ "$SUDO_UID" != "0" ] || die "uid 0 cannot register"
getent passwd "$SUDO_UID" >/dev/null 2>&1 || die "uid $SUDO_UID has no passwd entry"

op="${1:-}"
[ $# -gt 0 ] && shift

# Absolute path, no control characters (registry is line-based), bounded.
valid_home() {
  case "$1" in
    /*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *[[:cntrl:]]*) return 1 ;;
  esac
  [ "${#1}" -le 4096 ]
}

# The registry directory must be a real directory we control — never a
# symlink — with permissions only root can traverse.
prepare_regdir() {
  [ -L "$REGDIR" ] && die "$REGDIR is a symlink"
  mkdir -p "$REGDIR" || die "cannot create $REGDIR"
  [ -d "$REGDIR" ] || die "$REGDIR is not a directory"
  chmod 0750 "$REGDIR" || die "cannot secure $REGDIR"
}

case "$op" in
  register)
    [ $# -eq 2 ] || die "usage: pibot-hostctl register <host-home> <config-home>"
    home="$1"
    config_home="$2"
    valid_home "$config_home" || die "invalid config home"
    valid_home "$home" || die "invalid host home '$home'"
    [ -d "$home" ] || die "host home '$home' does not exist"
    prepare_regdir
    tmp="$REGDIR/.$SUDO_UID.tmp.$$"
    {
      echo "uid=$SUDO_UID"
      echo "home=$home"
      echo "configHome=$config_home"
    } > "$tmp" || die "cannot write $tmp"
    chmod 0640 "$tmp" || die "cannot secure $tmp"
    mv -f "$tmp" "$REGDIR/$SUDO_UID" || die "cannot install registry entry"
    loginctl enable-linger "$SUDO_UID" || die "cannot enable linger for uid $SUDO_UID"
    ;;
  unregister)
    [ $# -eq 0 ] || die "usage: pibot-hostctl unregister"
    rm -f "$REGDIR/$SUDO_UID" || die "cannot remove registry entry"
    ;;
  *)
    die "usage: pibot-hostctl register <host-home> <config-home>|unregister"
    ;;
esac
exit 0
