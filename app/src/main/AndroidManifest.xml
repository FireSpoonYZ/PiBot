<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Requested at first dictation; used by the system recognizer and remote transcription. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- Android 8+ 安装未知应用来源；仅在用户显式 updateInstall 返回 waiting-permission 时引导。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="pibot"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- M18：只在 :tauri_ui 提前初始化框架 lifecycle（ProcessLifecycleInitializer），让 Wry 的
             ON_CREATE 能通知 Rust 创建 UI；不拉起 Host/FGS/Node，默认进程 provider 不动。 -->
        <provider
            android:name=".TauriInitializationProvider"
            android:authorities="${applicationId}.tauri-startup"
            android:exported="false"
            android:process=":tauri_ui">
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
        </provider>
        <receiver android:name=".BotHostScheduleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".BotHostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device pibot Host and remote link accompanying the user-started client" />
        </service>
        <service
            android:name=".BotClientService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started pibot client and its background connection and task notifications" />
        </service>
        <!-- M18 UI 桥：默认进程、同 UID 私有 Binder；绑定本身不启动 Host/模型。 -->
        <service
            android:name=".BotHostUiBridgeService"
            android:exported="false" />
        <!-- Bot 屏幕：默认进程、同 UID 私有 Binder；只观看/接管已有 Shower 虚拟屏，不创建屏幕或启动 Host。 -->
        <service
            android:name=".BotScreenService"
            android:exported="false" />
        <!-- 客户端更新安装结果回执：默认进程、非导出；PackageInstaller status 回调。 -->
        <receiver
            android:name=".ClientUpdateResultReceiver"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/WebAppTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 拍照输出：:tauri_ui 私有 cache 的 FileProvider，仅本次相机 Intent 按包名授权读写。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.imagepicker"
            android:exported="false"
            android:grantUriPermissions="true"
            android:process=":tauri_ui">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/image_picker_paths" />
        </provider>
        <!-- M18 Tauri 界面：独立进程，SDK 退出只影响本进程；仅由 MainActivity/通知入口内部启动。 -->
        <activity
            android:name=".TauriMainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":tauri_ui"
            android:theme="@style/WebAppTheme"
            android:windowSoftInputMode="adjustResize" />
        <!-- 配对码扫描（PairingScanActivity，基于 zxing-android-embedded 的 CaptureManager）：与发起它的
             TauriMainActivity 同在 :tauri_ui 进程，不唤起 Host 所在的默认进程；库默认强制横屏，这里改为
             随传感器旋转。主题等属性沿用库对 CaptureActivity 的声明。 -->
        <activity
            android:name=".PairingScanActivity"
            android:clearTaskOnLaunch="true"
            android:exported="false"
            android:process=":tauri_ui"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!-- 库自带的 CaptureActivity 不再使用（会在默认进程、强制横屏、拒权限时弹误导性对话框），不打进 APK。 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            tools:node="remove" />
    </application>
</manifest>
