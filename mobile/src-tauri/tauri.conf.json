{
  "productName": "pibot",
  "version": "0.0.15",
  "identifier": "com.example.launcherprobe",
  "build": {
    "frontendDist": "../build/web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "pibot",
        "url": "index.html",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: https://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'",
      "capabilities": [
        "main"
      ],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "../../assets/icon.png"
    ]
  }
}
