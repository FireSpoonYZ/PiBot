# Copy to center.env and fill in real values. center.env is gitignored.
# The center listens on plain HTTP only; terminate TLS at your reverse proxy.

# Data directory inside the container (Compose volume mount point).
CENTER_DATA_ROOT=/data
# Bind address/port inside the container. Compose publishes 127.0.0.1:8080.
CENTER_LISTEN_HOST=0.0.0.0
CENTER_PORT=8080
# Public HTTPS origin clients use (scheme + host + optional port, no path).
# The WSS link URL (wss://<host>/v1/link) and OAuth callback are derived from it.
CENTER_PUBLIC_URL=https://center.example.com
# Comma-separated trusted proxy IPs/CIDRs, or 'true'/'false'. Default false:
# only set this to the actual reverse proxy address range.
CENTER_TRUST_PROXY=
# Static web root inside the image.
CENTER_WEB_ROOT=/app/center-web/dist
# Optional absolute path to npm-cli.js inside the container.
CENTER_NPM_PATH=
# Two independent 32-byte keys in hex (64 chars each).
CENTER_ENCRYPTION_KEY_HEX=
CENTER_SESSION_KEY_HEX=
# Owner password hash: scrypt$<16-byte salt hex>$<64-byte key hex>.
# Generate with: node center-server/cli.js password-hash
CENTER_OWNER_PASSWORD_HASH=
