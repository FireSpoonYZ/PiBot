# 复制为 center.env；敏感配置不得提交 Git。
# 中心只监听内部 HTTP，HTTPS/WSS 由反向代理提供。
CENTER_PUBLIC_URL=https://center.example.com
# 可选：逗号分隔的可信反向代理 IP/CIDR；默认 false。
CENTER_TRUST_PROXY=false

# 首次部署从本地日志读取初始化码，在网页设置所有者密码。
# 数据卷中持久化 center-config.json，包含密钥，备份时一并保护。
# 旧环境变量部署须完整保留以下三项；不要为已有数据重新生成密钥：
# CENTER_ENCRYPTION_KEY_HEX=<64 位 hex，32 字节>
# CENTER_SESSION_KEY_HEX=<64 位 hex，32 字节>
# CENTER_OWNER_PASSWORD_HASH='scrypt$<16 字节 salt hex>$<64 字节 key hex>'

# 可选：Vaultwarden 外部密码库使用的官方 Bitwarden CLI 入口路径。
# 镜像已内置 bw（/usr/local/bin/bw），仅在自管部署用其他可信安装时覆盖；
# 值为绝对路径（build/bw.js 或可执行文件），不得包含任何秘密。
# PIBOT_BW_CLI=/opt/bitwarden-cli/node_modules/@bitwarden/cli/build/bw.js
